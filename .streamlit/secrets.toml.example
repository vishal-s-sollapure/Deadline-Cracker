# .streamlit/secrets.toml.example
# Example Streamlit Secrets Configuration for Deadline Tracker — AI Academic Deadline Assistant
# Copy this file to '.streamlit/secrets.toml' and replace placeholders with your actual secrets.

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY = "your_gemini_api_key_here"

# Gmail SMTP Configuration for Email Summaries
# IMPORTANT: Generate a 16-character App Password via Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_ADDRESS = "your_email@gmail.com"
EMAIL_APP_PASSWORD = "your_gmail_app_password_here"

# Alternative key aliases supported by the application:
SENDER_EMAIL = "your_email@gmail.com"
SENDER_PASSWORD = "your_gmail_app_password_here"
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
